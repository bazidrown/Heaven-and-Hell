create_land {
	terrain_type SNOW
	base_size 4
	land_position 50 50
	land_percent 100
	clumping_factor 40
	if TINY_MAP
	top_border 30
	bottom_border 30
	right_border 30
	left_border 30
	else
	top_border 18
	bottom_border 18
	right_border 18
	left_border 18
	endif
	land_id 666
}  

<ELEVATION_GENERATION>
create_elevation 4
{
base_terrain SNOW
